APP_NAME=TradaSta AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./tradasta_auth.db
AUTH_REQUIRED_FOR_TRADING=false
JWT_SECRET_KEY=change-this-to-a-random-32-byte-secret-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_LOCKOUT_SECONDS=300
AI_REQUEST_RATE_LIMIT=30
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_MODE=webhook
TELEGRAM_API_BASE_URL=https://api.telegram.org
